#!/usr/bin/env bash
set -euo pipefail

KDTOOL="${KDTOOL_BIN:-$HOME/.cargo/bin/kdotool}"
window_id_pattern='^\{[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}\}$'

if (($# == 1)); then
	wid=$1
else
	wid=$("$KDTOOL" getmouselocation getwindowid 2>/dev/null | tail -n 1 | tr -d '\r[:space:]')
fi

[[ $wid =~ $window_id_pattern ]] || exit 0

# KWin can accept the request asynchronously while the client window is still
# present. Retry only this captured ID and stop as soon as it disappears.
for ((attempt = 1; attempt <= 4; attempt++)); do
	"$KDTOOL" windowclose "$wid" >/dev/null 2>&1 || true
	sleep 0.025
	if ! "$KDTOOL" getwindowname "$wid" >/dev/null 2>&1; then
		exit 0
	fi
done

exit 0
