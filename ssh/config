Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    UserKnownHostsFile ~/Dev/config/ssh/known_hosts-managed ~/.ssh/known_hosts

Host ai
    HostName 192.168.50.30
    Port 22
    User lewis
    HostKeyAlias ai
    HostKeyAlgorithms ssh-ed25519
    UserKnownHostsFile ~/Dev/config/ssh/known_hosts-managed
    StrictHostKeyChecking yes
    CheckHostIP no
    UpdateHostKeys no

