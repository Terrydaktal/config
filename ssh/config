#knowthatstuff and dictai
Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3

# The same physical computer dual-boots Linux and Windows.  Each OS is a
# separate SSH server identity even though both use 192.168.50.30:22.
Host ai lewis-linux
    HostName 192.168.50.30
    User lewis
    Port 22
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    HostKeyAlias lewis-linux
    HostKeyAlgorithms ssh-ed25519
    UserKnownHostsFile ~/Dev/config/ssh/known_hosts-managed
    StrictHostKeyChecking yes
    CheckHostIP no
    UpdateHostKeys no

Host lewis-linux-root
    HostName 192.168.50.30
    User root
    Port 22
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    HostKeyAlias lewis-linux
    HostKeyAlgorithms ssh-ed25519
    UserKnownHostsFile ~/Dev/config/ssh/known_hosts-managed
    StrictHostKeyChecking yes
    CheckHostIP no
    UpdateHostKeys no

Host windows lewis-windows
    HostName 192.168.50.30
    Port 22
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    HostKeyAlias lewis-windows
    HostKeyAlgorithms ssh-ed25519
    UserKnownHostsFile ~/Dev/config/ssh/known_hosts-managed
    StrictHostKeyChecking yes
    CheckHostIP no
    UpdateHostKeys no

Host windows
    User lewis

# Compatibility login for the Windows SSH account used before the lewis account
# is verified or provisioned on the next Windows boot.
Host lewis-windows
    User lewisssh

